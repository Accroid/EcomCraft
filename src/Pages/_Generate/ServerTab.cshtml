@model GeneratePageModel

<ul class="nav nav-tabs" role="tablist" id="servertablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link active translate" data-bs-toggle="tab" href="#Server-Info" id="serverinfotabbutton" aria-selected="true" role="tab">Server Info</a>
    </li>
    <li class="nav-item" role="presentation" data-requiredpermission="view_backends_list">
        <a class="nav-link translate" data-bs-toggle="tab" href="#Settings-Backends" id="serverbackendstabbutton" aria-selected="false" role="tab">Backends</a>
    </li>
    <li class="nav-item" role="presentation" data-requiredpermission="read_server_settings">
        <a class="nav-link translate" data-bs-toggle="tab" href="#Settings-Server" id="serverconfigtabbutton" aria-selected="false" tabindex="-1" role="tab">Server Configuration</a>
    </li>
    <li class="nav-item" role="presentation" data-requiredpermission="manage_users">
        <a class="nav-link translate" data-bs-toggle="tab" href="#Server-ManageUsers" id="manageusersbutton" aria-selected="false" tabindex="-1" role="tab">Users</a>
    </li>
    <li class="nav-item" role="presentation" data-requiredpermission="manage_extensions">
        <a class="nav-link translate" data-bs-toggle="tab" href="#Server-Extensions" id="extensionstabbutton" aria-selected="false" tabindex="-1" role="tab">Extensions</a>
    </li>
    <li class="nav-item" role="presentation" data-requiredpermission="view_logs">
        <a class="nav-link translate" data-bs-toggle="tab" href="#Server-Logs" id="logtabbutton" aria-selected="false" tabindex="-1" role="tab">Logs</a>
    </li>
</ul>
<div class="tab-content tab-no-scroll">
    <div class="tab-pane show active scroll-within-tab" id="Server-Info" role="tabpanel">
        <div class="card border-secondary mb-3 card-center-container">
            <div class="card-header translate">Server</div>
            <div class="card-body">
                <div class="card-text">
                    <span class="translate">The "Server" tab provides access to SwarmUI's server internals, including:</span>
                    <span data-requiredpermission="view_backends_list"><br>&bullet; <a href="#Settings-Backends" onclick="getRequiredElementById('serverbackendstabbutton').click()"><span class="translate">Backends</span></a> <span class="translate">tab: configure and manage backends (the underlying engines that provide the generation core, or remote instances of swarm this instance is connected to)</span></span>
                    <span data-requiredpermission="read_server_settings"><br>&bullet; <a href="#Settings-Server" onclick="getRequiredElementById('serverconfigtabbutton').click()"><span class="translate">Server Configuration</span></a> <span class="translate">tab: configure and manage Swarm's settings (such as models directory, server host port, etc)</span></span>
                    <span data-requiredpermission="manage_extensions"><br>&bullet; <a href="#Server-Extensions" onclick="getRequiredElementById('extensionstabbutton').click()"><span class="translate">Extensions</span></a> <span class="translate">tab: manage your Swarm extensions or install new ones</span></span>
                    <span data-requiredpermission="view_logs"><br>&bullet; <a href="#Server-Logs" onclick="getRequiredElementById('logtabbutton').click()"><span class="translate">Logs</span></a> <span class="translate">tab: view the server logs (eg if you get an error, check Logs -> Debug)</span></span>
                    <br>
                    <br><span class="translate">This is not to be confused with the</span> <a href="#user_tab" onclick="getRequiredElementById('usersettingstabbutton').click();getRequiredElementById('userconfigtabbutton').click()"><span class="translate">User Settings</span></a> <span class="translate">tab, which allows you to configure your user settings (eg save path/format, default VAE choice, etc)</span>
                </div>
            </div>
        </div>
        <div class="card-collection-inline">
            @if (Utilities.DotNetVersMissing is not null)
            {
                <div class="card border-red mb-3 card-center-container">
                    <div class="card-header translate">DotNET @Utilities.DotNetVersMissing Missing</div>
                    <div class="card-body">
                        <div id="dotnet_missing_message" class="card-text">
                            <span class="translate">You do not seem to have DotNET @Utilities.DotNetVersMissing installed - this will be required in a future version of SwarmUI.</span>
                            <br><span class="translate">Please install DotNET SDK @(Utilities.DotNetVersMissing).0 from</span> <a target="_blank" href="https://dotnet.microsoft.com/en-us/download/dotnet/@(Utilities.DotNetVersMissing).0">https://dotnet.microsoft.com/en-us/download/dotnet/@(Utilities.DotNetVersMissing).0</a>
                            @if (WebUtil.IsWindows())
                            {
                                <span data-requiredpermission="install">
                                    <br><span class="translate">Or click here:</span> <button id="dotnet_install_update_button" class="basic-button translate" onclick="genericRequest('InstallDotnetUpdate', {}, () => {});getRequiredElementById('dotnet_install_update_button').disabled = true">Install DotNET SDK @(Utilities.DotNetVersMissing).0</button>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
            @if (Program.CurrentGitDate == "Git failed to load")
            {
                <div class="card border-red mb-3 card-center-container">
                    <div class="card-header translate">Git Failed To Load</div>
                    <div class="card-body">
                        <div id="git_failed_message" class="card-text">
                            <span class="translate">You seem to have installed SwarmUI improperly. Many features, including auto-updating, will not work.</span>
                            <br><span class="translate">Please install SwarmUI as explained in</span> <a target="_blank" href="https://github.com/mcmonkeyprojects/SwarmUI?tab=readme-ov-file#installing-on-windows"><span class="translate">The readme install instructions.</span></a>
                        </div>
                    </div>
                </div>
            }
            <div class="card border-secondary mb-3 card-center-container server-status-card" data-requiredpermission="read_server_info_panels">
            <div class="card-header translate">Server Status</div>
                <div class="card-body">
                    <div class="server-status-section">
                        <div class="server-status-section-title translate">Local Network</div>
                        <div class="card-text">
                            @if (Program.ServerSettings.Network.Host == "127.0.0.1" || Program.ServerSettings.Network.Host == "localhost")
                            {
                                <span class="translate">This server is only accessible from this computer.</span>
                            }
                            else
                            {
                                string address = Utilities.GetLocalIPAddress();
                                if (address is null)
                                {
                                    <span><span class="translate">Unknown local address, but seems to be open to LAN based on Host setting</span>
                                    <br>'<b>@(Program.ServerSettings.Network.Host)</b>'</span>
                                }
                                else
                                {
                                    <span><span class="translate">This server is likely accessible from LAN on one of the following addresses:</span>
                                    <br>@(address)</span>
                                }
                            }
                            @if (Program.ProxyHandler is not null && Program.ProxyHandler.PublicURL is not null)
                            {
                                <span><span class="translate">This server is also accessible from the open internet at:</span>
                                <br>@(Program.ProxyHandler?.PublicURL)</span>
                            }
                        </div>
                    </div>
                    <div class="server-status-section">
                        <div class="server-status-section-title translate">Resource Usage</div>
                        <div class="card-text translate" id="resource_usage_area">
                            (Loading...)
                        </div>
                    </div>
                    <div class="server-status-section">
                        <div class="server-status-section-title translate">Connected Users</div>
                        <div class="card-text translate" id="connected_users_list">
                            (Loading...)
                        </div>
                    </div>
                </div>
            </div>
            <div class="card border-secondary mb-3 card-center-container" style="min-width: 400px;">
                <div class="card-header translate">Manage Server</div>
                <div class="card-body">
                    <div class="server-manage-section border-secondary" id="server_updates_card" data-requiredpermission="restart">
                        <div class="server-status-section-title translate">Update</div>
                        <span class="card-text">
                            @if (Program.VersionUpdateMessageShort is not null)
                            {
                                <div>@(new HtmlString(Program.VersionUpdateMessageShort))</div>
                            }
                            <span id="updates_available_notice_area" class="translate" style="white-space:pre-wrap">(Loading...)</span>
                            <hr>
                            <input class="form-check-input" type="checkbox" id="server_update_aggressive" autocomplete="off"> <label for="server_update_aggressive" class="translate">Aggressive Update</label>
                            &emsp;
                            <input class="form-check-input" type="checkbox" id="server_update_force_restart" autocomplete="off"> <label for="server_update_force_restart" class="translate">Force Restart</label>
                            <br><br>
                            <button class="basic-button translate" onclick="check_for_updates()">Check For Updates</button>
                            <button class="basic-button danger-button translate" id="update_and_restart_button" onclick="update_and_restart_server()" disabled>Update and Restart Server</button>
                            <span id="update_server_notice_area"></span>
                        </span>
                    </div>
                    <div class="server-manage-section" data-requiredpermission="control_mem_clean">
                        <hr>
                        <div class="server-status-section-title translate">Free Memory</div>
                        <div class="card-text">
                            <span class="translate">You can free up the VRAM usage, or system memory usage (cache) from backends with the two buttons below.</span>
                            <br>
                            <button class="basic-button danger-button translate" onclick="server_clear_vram()">Free VRAM</button>
                            <button class="basic-button danger-button translate" onclick="server_clear_sysram()">Free System RAM</button>
                        </div>
                    </div>
                    <div class="server-manage-section" data-requiredpermission="shutdown">
                        <hr>
                        <div class="server-manage-shutdown">
                            <div class="server-status-section-title translate">Shutdown</div>
                            <div class="card-text">
                                <span data-requiredpermission="shutdown">
                                <span class="translate">If you want to shut down the server, click the button below.</span>
                                <br><button class="basic-button danger-button translate" onclick="shutdown_server()">Shutdown Server</button>
                                </span>
                                <span id="shutdown_notice_area"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="tab-pane scroll-within-tab" id="Settings-Backends" role="tabpanel">
        <div class="comfy-discovery" data-requiredpermission="edit_backends">
            <button type="button" class="basic-button" id="comfy-discovery-scan">Scan ComfyUI</button>
            <select id="comfy-discovery-path" aria-label="Select ComfyUI installation" hidden></select>
            <select id="comfy-discovery-target" aria-label="Select ComfyUI backend" hidden></select>
            <button type="button" class="basic-button" id="comfy-discovery-use" hidden>Use selected path</button>
            <span id="comfy-discovery-status" role="status"></span>
        </div>
        <div class="backend_add_button_container">
            <span class="translate">Add new backend of type:</span>
            <span class="form-check form-switch display-inline-block">
                <input class="form-check-input translate" type="checkbox" id="backends_show_advanced" title="Show Advanced Backend Types" onclick="toggleShowAdvancedBackends()" autocomplete="off"> <span class="translate">Show Advanced</span>
            </span>
            <div id="backend_add_buttons"></div>
        </div>
        <div>
            <button class="basic-button translate" onclick="restart_all_backends()">Restart All Backends</button>
        </div>
        <div class="backends_list" id="backends_list"></div>
    </div>
    <div class="tab-pane scroll-within-tab" id="Settings-Server" role="tabpanel">
        <div id="server_settings_container" class="settings-container"></div>
        <div class="settings_submit_confirmer" id="serversettings_confirmer">
            <span class="settings_submit_confirmer_text"><span class="translate">Save</span> <span id="serversettings_edit_count">0</span> <span class="translate">edited setting(s)?</span></span>
            <button type="button" class="btn btn-primary basic-button translate" onclick="save_server_settings()">Save</button>
            <button type="button" class="btn btn-secondary basic-button translate" onclick="cancel_server_settings_edit()">Cancel</button>
        </div>
    </div>
    <div class="tab-pane" id="Server-Logs" role="tabpanel">
        @WebUtil.ModalHeader("do_log_pastebin_modal", "Submit Logs To Pastebin")
            <div class="modal-body">
                <p class="translate">This will submit the text of your server logs to a <a target="_blank" class="translate" href="https://paste.denizenscript.com/New/Swarm">public pastebin service</a>. This is to make it easy to share debug logs when getting support on the <a target="_blank" class="translate" href="https://discord.gg/q2y38cqjNw">SwarmUI discord</a>.</p>
                <p class="translate">Once submitted, your server logs will be visible to the public and not easily deletable. Please ensure your logs do not contain private information (eg personal prompts) before autosubmitting.</p>
                <p class="translate">(If your logs do have private information, please restart and replicate whatever you need to show, then pastebin the logs).</p>
                <p class="translate">(Alternately, you can manually submit and edit the content first via <a target="_blank" class="translate" href="https://paste.denizenscript.com/New/Swarm">this link</a>, just be sure not to delete anything important).</p>
                <span class="translate">Which minimum log level would you like to submit?</span> <select id="log_pastebin_type" autocomplete="off"><option>verbose</option><option selected>debug</option><option>info</option></select>
                <div id="log_pastebin_result_area"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary basic-button translate" id="log_submit_pastebin_button">Submit</button>
                <button type="button" class="btn btn-secondary basic-button translate" id="log_cancel_pastebin_button" onclick="$('#do_log_pastebin_modal').modal('hide')">Cancel</button>
            </div>
        @WebUtil.ModalFooter()
        <center><span class="translate">View:</span> <select id="server_log_type_selector"></select> <span class="translate">Filter:</span> <input type="text" id="server_log_filter" class="translate" placeholder="Filter" /> <button class="basic-button translate" id="server_log_pastebin">Pastebin</button></center>
        <div id="server_logs_container" class="server_logs_container"></div>
    </div>
    <div class="tab-pane scroll-within-tab" id="Server-Extensions" role="tabpanel">
        <div class="card border-secondary mb-3 card-center-container">
            <div class="card-header translate">Extensions</div>
            <div class="card-body">
                <div class="card-text">
                    <span class="translate">The "Extensions" tab lets you control your installed Swarm extensions, or install new ones.</span>
                </div>
            </div>
        </div>
        <div class="card border-warning mb-3 card-center-container" id="extensions_installed_card" style="display:none">
            <div class="card-header translate">New Extensions Installed</div>
            <div class="card-body">
                <div class="card-text">
                    <span class="translate">Extensions installed or updated. Changes will apply the next time you restart the SwarmUI server.</span>
                    <div><button class="basic-button translate" id="extension_restart_button" onclick="extensionsManager.restartServer()">Restart Now</button></div>
                </div>
            </div>
        </div>
        <center>
            <h3 class="translate">Installed Extensions</h3>
            <table class="simple-table">
                <tr>
                    <th class="translate">Name</th>
                    <th class="translate">Version</th>
                    <th class="translate">Tags</th>
                    <th class="translate">Author</th>
                    <th class="translate">Description</th>
                    <th class="translate">Readme</th>
                    <th class="translate">License</th>
                    <th class="translate">Actions</th>
                </tr>
                @foreach (Extension ext in Program.Extensions.Extensions.Where(e => !e.IsCore && !Program.Extensions.IsDisabled(ExtensionsManager.GetFolderNameFromPath(e.FilePath))))
                {
                    <tr>
                        <td>@ext.ExtensionName</td>
                        <td><code>@ext.Version</code></td>
                        <td>@ExtensionsManager.HtmlTags(ext.Tags)</td>
                        <td>@ext.ExtensionAuthor</td>
                        <td>
                            <span class="translate">@ext.Description</span>
                            @if (ext.IsOldRepo)
                            {
                                <br><span class="translate modal_error_bottom">!! You have an old version of this extension installed. It has been replaced by a new repo. Please uninstall, restart, then reinstall. See the README for any extension-specific instructions. !!</span>
                            }
                        </td>
                        <td>@(ext.ReadmeURL == "" ? new HtmlString("<span class=\"translate\">(Missing)</span>") : new HtmlString($"<a target=\"_blank\" class=\"translate\" href=\"{ext.ReadmeURL}\">Here</a>"))</td>
                        <td class="@(WebUtil.LicenseIsFoss(ext.License) ? "" : "ext-danger-license")">@ext.License</td>
                        <td>
                            <button class="basic-button danger-button translate" onclick="extensionsManager.setExtensionEnabled('@ext.ExtensionName', false, this)">Disable</button>
                            @if (ext.CanUpdate)
                            {
                                <button class="basic-button translate" onclick="extensionsManager.updateExtension('@ext.ExtensionName', this)">Update</button>
                            }
                            <button class="basic-button translate" onclick="extensionsManager.uninstallExtension('@ext.ExtensionName', this)">Uninstall</button>
                        </td>
                    </tr>
                }
                @foreach (ExtensionsManager.ExtensionInfo ext in Program.Extensions.GetDisabledExtensionsForUi())
                {
                    <tr>
                        <td>@ext.Name</td>
                        <td><code class="translate">(Disabled)</code></td>
                        <td class="@(ext.IsDangerTags ? "ext-danger-license" : "")">@ExtensionsManager.HtmlTags(ext.Tags)</td>
                        <td>@ext.Author</td>
                        <td><span class="translate">@ext.Description</span></td>
                        <td>@(ext.URL == "" ? new HtmlString("<span class=\"translate\">(Missing)</span>") : new HtmlString($"<a target=\"_blank\" class=\"translate\" href=\"{ext.URL}\">Here</a>"))</td>
                        <td class="@(WebUtil.LicenseIsFoss(ext.License) ? "" : "ext-danger-license")">@ext.License</td>
                        <td>
                            <button class="basic-button translate" onclick="extensionsManager.setExtensionEnabled('@ext.FolderNames[0]', true, this)">Enable</button>
                            <button class="basic-button translate" onclick="extensionsManager.uninstallExtension('@ext.FolderNames[0]', this)">Uninstall</button>
                        </td>
                    </tr>
                }
            </table>
            <br>
            <h3 class="translate">Available Extensions</h3>
            <input class="form-check-input translate" type="checkbox" id="extensions_show_hidden" title="Show Hidden Extensions" onclick="extensionsManager.toggleShowHidden()" autocomplete="off"> <label for="extensions_show_hidden" class="translate">Show Hidden</label>
            <table class="simple-table" id="available_extensions_table">
                <tr>
                    <th class="translate">Name</th>
                    <th class="translate">Tags</th>
                    <th class="translate">Author</th>
                    <th class="translate">Description</th>
                    <th class="translate">Readme</th>
                    <th class="translate">License</th>
                    <th class="translate">Actions</th>
                </tr>
                @foreach (ExtensionsManager.ExtensionInfo ext in Program.Extensions.KnownExtensions.Where(e => !e.FolderNames.Any(fn => Program.Extensions.LoadedExtensionFolders.Contains(fn))).OrderBy(e => e.IsDangerTags ? 1 : 0))
                {
                    <tr class="@(ext.Tags.Contains("hidden") ? "extension-hidden-row" : "")">
                        <td>@ext.Name</td>
                        <td class="@(ext.IsDangerTags ? "ext-danger-license" : "")">@ExtensionsManager.HtmlTags(ext.Tags)</td>
                        <td>@ext.Author</td>
                        <td><span class="translate">@ext.Description</span></td>
                        <td><a target="_blank" href="@ext.URL" class="translate">Here</a></td>
                        <td class="@(WebUtil.LicenseIsFoss(ext.License) ? "" : "ext-danger-license")">@ext.License</td>
                        <td>
                            <button class="basic-button translate" onclick="extensionsManager.installExtension('@ext.Name', this)">Install</button>
                        </td>
                    </tr>
                }
            </table>
        </center>
    </div>
    <div class="tab-pane" id="Server-ManageUsers" role="tabpanel">
        @WebUtil.ModalHeader("server_add_user_menu", "Add New User Account")
            <div class="modal-body">
                <p class="translate">This will add a new user account to your SwarmUI server.</p>
                <p class="translate">Please configure carefully, the account will be active immediately upon click 'Add' below.</p>
                <p class="translate">Click 'Cancel' if you're not ready to add a user.</p>
                <div id="add_user_menu_inputs"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary basic-button translate" onclick="userAdminManager.addUserMenuSubmit()">Add</button>
                <button type="button" class="btn btn-secondary basic-button translate" onclick="$('#server_add_user_menu').modal('hide')">Cancel</button>
            </div>
        @WebUtil.ModalFooter()
        @WebUtil.ModalHeader("server_add_role_menu", "Add New User Permission Role")
            <div class="modal-body">
                <p class="translate">This will add a new user permission role to your SwarmUI server.</p>
                <p class="translate">This should be used when you need to define unique contexts in which certain users get a certain subset of permissions.</p>
                <p class="translate">For the most part, you should just configure the base set of roles rather than adding new ones..</p>
                <p class="translate">Click 'Cancel' if you're not ready to add a user.</p>
                <div id="add_role_menu_inputs"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary basic-button translate" onclick="userAdminManager.addRoleMenuSubmit()">Add</button>
                <button type="button" class="btn btn-secondary basic-button translate" onclick="$('#server_add_role_menu').modal('hide')">Cancel</button>
            </div>
        @WebUtil.ModalFooter()
        @WebUtil.ModalHeader("server_change_user_password_modal", "Change User Password")
            <div class="modal-body">
                <p class="translate">This form lets you change another user's password. Be sure to tell them what their new password is, and that they should change their password themself after.</p>
                <br><span class="translate">New Password:</span> <input type="text" class="auto-text auto-text-block password translate translate-no-text" id="server_change_user_password_new_password" placeholder="Enter new password..." autocomplete="off" value="" />
                <br><span class="translate">Confirm New Password:</span> <input type="text" class="auto-text auto-text-block password translate translate-no-text" id="server_change_user_password_new_password2" placeholder="Confirm new password..." autocomplete="off" value="" />
                <div id="server_change_user_password_result_area"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary basic-button translate" id="server_change_user_password_submit_button" onclick="userAdminManager.changeUserPwSubmit()">Submit</button>
                <button type="button" class="btn btn-secondary basic-button translate" id="server_change_user_password_cancel_button" onclick="$('#server_change_user_password_modal').modal('hide')">Cancel</button>
            </div>
        @WebUtil.ModalFooter()
        <div class="manage-users-left" id="manage_users_leftbox">
            <div class="input_filter_container">
                <input type="text" class="main_inputs_filter auto-text translate" id="admin_user_filter" oninput="userAdminManager.updateFilter()" placeholder="Filter users/roles..." />
                <span class="clear_input_icon" id="admin_user_clear_input_icon" onclick="userAdminManager.clearFilter()">&#x2715;</span>
            </div>
            <div class="manage-users-left-header">
                <span class="manage-users-left-title translate">Roles</span>
                <button class="basic-button translate" onclick="userAdminManager.showAddRoleMenu()" title="Add a new role...">Add Role</button>
            </div>
            <div class="manage_user_leftbox_content" id="manage_users_leftbox_content_rolelist"></div>
            <div class="manage-users-left-header">
                <span class="manage-users-left-title translate">Users</span>
                <button class="basic-button translate" onclick="userAdminManager.showAddUserMenu()" title="Add a new user...">Add User</button>
            </div>
            <div class="manage_user_leftbox_content" id="manage_users_leftbox_content_userlist"></div>
        </div>
        <div class="splitter-bar" id="manage_users_splitbar"></div>
        <div class="manage-users-right" id="manage_users_rightbox">
            <div id="manage_users_rightbox_content"></div>
        </div>
    </div>
</div>
